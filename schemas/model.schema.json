{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HydroTuring model manifest",
  "type": "object",
  "required": ["name", "version", "entrypoint", "timestep", "emits"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "version": {"type": "string"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "description": {"type": "string"},
    "reference": {"type": "string", "description": "DOI or URL for the model."},
    "license": {"type": "string"},
    "runner": {
      "enum": ["subprocess", "docker"],
      "default": "docker",
      "description": "subprocess is reserved for in-repo reference models. Submissions use docker."
    },
    "entrypoint": {
      "type": "array", "minItems": 1, "items": {"type": "string"},
      "description": "argv prefix. The harness appends --request <path>."
    },
    "timestep": {"type": "string", "enum": ["PT1H", "PT1D"]},
    "emits": {
      "type": "object",
      "required": ["fluxes", "states"],
      "additionalProperties": false,
      "properties": {
        "fluxes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "states": {
          "type": "array", "items": {"type": "string"}, "uniqueItems": true,
          "description": "Absolute storage values, never tendencies. The harness differences them."
        }
      }
    },
    "needs_forcing": {"type": "array", "items": {"type": "string"}},
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"perturbation": {"type": "boolean"}}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"type": "integer", "minimum": 1, "maximum": 8},
        "memory_gb": {"type": "number", "minimum": 0.5, "maximum": 32},
        "gpu": {"type": "boolean"}
      }
    }
  }
}
