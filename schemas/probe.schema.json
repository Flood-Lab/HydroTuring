{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HydroTuring probe specification",
  "type": "object",
  "required": ["id", "title", "law", "track", "version", "requires", "case", "criteria", "baselines"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(mass|energy|momentum|real)/[a-z0-9][a-z0-9-]*$",
      "description": "law/slug. Must match the probe's directory path under probes/."
    },
    "title": {"type": "string", "minLength": 8},
    "law": {"enum": ["mass", "energy", "momentum"]},
    "track": {"enum": ["synthetic", "real"]},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fluxes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "states": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "case": {
      "type": "object",
      "required": ["generator", "n_seeds", "timestep", "period_years", "spinup_days"],
      "additionalProperties": false,
      "properties": {
        "generator": {"type": "string", "description": "Deterministic given a seed."},
        "n_seeds": {"type": "integer", "minimum": 1, "maximum": 25},
        "timestep": {"type": "string", "enum": ["PT1H", "PT1D"]},
        "period_years": {"type": "number", "minimum": 1},
        "spinup_days": {"type": "integer", "minimum": 0},
        "max_output_mb": {"type": "number", "minimum": 0.1, "maximum": 50},
        "max_runtime_s": {"type": "number", "minimum": 1, "maximum": 600}
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "minProperties": 1, "maxProperties": 1}
    },
    "baselines": {
      "type": "object",
      "required": ["must_pass", "must_fail"],
      "additionalProperties": false,
      "properties": {
        "must_pass": {
          "type": "array", "minItems": 1, "items": {"type": "string"},
          "description": "Reference models that must return PASS. Guards against tolerance drift."
        },
        "must_fail": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string"},
          "description": "Map of reference model -> the criterion name it must trip. Pins which criterion does the catching."
        }
      }
    },
    "provenance": {"type": "string"}
  }
}
