{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HydroTuring probe specification",
  "type": "object",
  "required": [
    "id",
    "title",
    "law",
    "track",
    "version",
    "authors",
    "requires",
    "case",
    "criteria",
    "baselines"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(mass|energy|momentum|real)/[a-z0-9][a-z0-9-]*$",
      "description": "law/slug. Must match the probe's directory path under probes/."
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "law": {
      "enum": [
        "mass",
        "energy",
        "momentum"
      ]
    },
    "track": {
      "enum": [
        "synthetic",
        "real"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "description": "Who wrote this probe. Carried into every report that runs it, and the basis for authorship on the benchmark paper.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "affiliation": {
            "type": "string"
          },
          "orcid": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$"
          },
          "github": {
            "type": "string"
          }
        }
      }
    },
    "description": {
      "type": "string"
    },
    "citation": {
      "type": "string",
      "description": "DOI or reference for the physics this probe encodes, if it comes from published work."
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fluxes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "generator",
        "n_seeds",
        "timestep",
        "spinup_days"
      ],
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "string",
          "description": "Deterministic given a seed."
        },
        "n_seeds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "timestep": {
          "type": "string",
          "enum": [
            "PT1D",
            "PT1H",
            "PT15M",
            "PT5M",
            "PT1M"
          ],
          "description": "The step the control case runs at. Fluxes are rates in mm/day at every step."
        },
        "period_years": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Length of the scored record in years. Use period_days for a short sub-daily record."
        },
        "spinup_days": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_mb": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 50
        },
        "max_runtime_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 600
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "Paired-run probes only. Names of the cases the generator produces for one seed; the model is run once per variant and paired criteria compare the results. The first name is the control."
        },
        "period_days": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Length of the scored record in days; an alternative to period_years."
        },
        "timesteps": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "PT1D",
              "PT1H",
              "PT15M",
              "PT5M",
              "PT1M"
            ]
          },
          "description": "Paired-run probes only. The step each named variant runs at, where it differs from case.timestep. The control keeps case.timestep. This is how a resolution transform is declared: the same weather at two steps."
        }
      },
      "anyOf": [
        {
          "required": [
            "period_years"
          ]
        },
        {
          "required": [
            "period_days"
          ]
        }
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1
      }
    },
    "baselines": {
      "type": "object",
      "required": [
        "must_pass",
        "must_fail"
      ],
      "additionalProperties": false,
      "properties": {
        "must_pass": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Reference models that must return PASS. Guards against tolerance drift."
        },
        "must_fail": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map of reference model -> the criterion name it must trip. Pins which criterion does the catching."
        }
      }
    },
    "provenance": {
      "type": "string"
    }
  }
}
